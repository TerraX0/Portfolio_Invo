<!DOCTYPE html>
    <html lang="de">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Default Title{% endblock %}</title>
        <!--favicon -->
      <link rel="icon" type="image/png" sizes="32x32" href="{{ asset('images/icons/favicon/favicon-32x32.png') }}">
<link rel="icon" type="image/png" sizes="16x16" href="{{ asset('images/icons/favicon/favicon-16x16.png') }}">

        {% block stylesheets %}
            {% include 'partials/stylesheets.html.twig' ignore missing %}
        {% endblock %}

</head>
<body>
{% block body %}


        {% set show_logo = show_logo|default(false) %}

    {% if show_header is defined and show_header %}
        {% include 'partials/header.html.twig' ignore missing %}
    {% endif %}

    <div class="main-container">

            {% block sidebar %}
                {% if show_sidebar is defined and show_sidebar %}
                    <div class="sidebar-wrapper">
                    {% include 'partials/sidebar.html.twig' %}
                    </div> <!-- End sidebar-wrapper -->
                {% endif %}
            {% endblock %}

        <div class="content-wrapper">
            {% include 'partials/flash_messages.html.twig' %}

            <main class="content">
                {% block content %}
                    <!-- Hauptinhalt -->
                {% endblock %}

            </main> <!-- End content -->

        </div> <!-- End content-wrapper -->

    </div> <!-- End main-container -->
{% endblock %}

 <!-- Footer -->
    <footer class="modern-footer">
        <div class="footer-container">
            <div class="footer-copyright">
                © {{ 'now'|date('Y') }} Alina Köllner. Alle Rechte vorbehalten.
            </div>
            <ul class="footer-links">
                <li>  
                    <a href="https://www.alinakoellner.de/" target="_blank" class="footer-link">Kontakt</a>
                 </li>

            </ul>
        </div>
    </footer>

{% block javascripts %}
    <script src="{{ asset('js/home_tabs.js') }}"></script>
{% endblock %}

</body>
</html>
