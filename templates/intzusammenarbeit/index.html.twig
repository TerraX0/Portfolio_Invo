{% extends 'base.html.twig' %}
{% set show_header = true %}
{% set show_sidebar = true %}
{% block title %}Int.Zusammenarbeit{% endblock %}

{% block content %}
    <h1 class="page-title">{{ title }}</h1>
    {{ form_start(form, {'attr': {'class': 'form'}}) }}

    <div class="form-container01">Vorgangsdaten</div>
    <div class="form-grid">
        {% for field in [form.id,form.vorgangsnummer,form.vorgangsdatum,
            form.einsendende_dst,
            form.eingang,
            form.geschaeftszeichen] %}
            <div class="form-item floating-label-container">
                {% include 'partials/floating_labels.html.twig' with {'field': field} %}
            </div>
        {% endfor %}
    </div>
<div class="form-container01">Persönliche Daten</div>
<div class="form-grid">
    {% for field in [form.name, form.vorname, form.gebdatum] %}
        <div class="form-item floating-label-container">
            {% include 'partials/floating_labels.html.twig' with {'field': field} %}
        </div>
    {% endfor %}
</div>

    <div class="form-container01">Inhalt des Schreibens</div>
<div class="form-grid">
    <div class="form-container">
        <div class="form-item floating-label-container">
            {% include 'partials/floating_labels.html.twig' with {'field': form.inhalt} %}
        </div>
    </div>
</div>
    <div class="form-grid">
    <div class="form-container">
        <div class="form-item floating-label-container">
            {% include 'partials/floating_labels.html.twig' with {'field': form.link} %}
        </div>
    </div>
    </div>
    <div class="form-container01">Massnahmen</div>
    <div class="form-grid">
        <div class="form-item floating-label-container">
            {% include 'partials/floating_labels.html.twig' with {'field': form.massnahmen} %}
        </div>
    </div>

    <div class="form-container01">Hinweise</div>
    <div class="form-grid">
            <div class="form-item floating-label-container">
        {% include 'partials/floating_labels.html.twig' with {'field': form.hinweise} %}
            </div>
    </div>
    <div class="form-grid">
        <div class="form-item floating-label-container">
            {% include 'partials/floating_labels.html.twig' with {'field': form.bearbeitung} %}
        </div>
    </div>


    <div class="form-container01">Fristen</div>
    <div class="form-grid">
        {% for field in [form.wv, form.erledigung, form.erfassung,
            form.aussonderung,
            form.reminder] %}
            <div class="form-item floating-label-container">
                {% include 'partials/floating_labels.html.twig' with {'field': field} %}
            </div>
        {% endfor %}
    </div>

    <div class="form-container01">Kataloge</div>
    <div class="form-grid">
        {% for field in [form.ipkenner, form.auslaendische_behoerde, ] %}
            <div class="form-item floating-label-container">
                {% include 'partials/floating_labels.html.twig' with {'field': field} %}
            </div>
        {% endfor %}
    </div>

    <div class="action-buttons">
        <button class="btn-primary" type="submit">
            {% if intzusammenarbeit is defined and intzusammenarbeit.id is not null %}
                Änderungen speichern
            {% else %}
                Speichern
            {% endif %}
        </button>
        {% if intzusammenarbeit is defined and intzusammenarbeit.id is not null %}
            <a href="{{ path('intzusammenarbeit') }}" class="btn-primary">Zur Speichermaske</a>
        {% endif %}
        <a href="{{ path('intzusammenarbeit_search') }}" class="btn btn-primary">Zur Suchmaske</a>
        <a href="{{ path('home') }}" class="btn btn-primary">Zurück zur Startseite</a>
        <!--Löschbutton-->
        {% if intzusammenarbeit is defined and intzusammenarbeit.id is not null %}
            <a href="{{ path('intzusammenarbeit_delete', {'id': intzusammenarbeit.id}) }}"
               class="btn-orange"
               onclick="return confirm('Möchtest du diesen Eintrag wirklich löschen?');">
                Löschen
            </a>
        {% endif %}
    </div>

    {{ form_end(form) }}
{% endblock %}
