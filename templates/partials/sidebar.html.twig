<div class="sidebar">
    <ul>
        {# 1. ARRAY: Alle Dummy-Routen auf '#' #}
        {% set menu_items = [
            {'route': '/', 'label': 'Home', 'icon': 'images/icons/home.svg'},
            {'route': '#', 'label': 'Kunden', 'icon': 'images/icons/pen.svg'},
             {'route': '#', 'label': 'Lieferanten', 'icon': 'images/icons/pen.svg'},
            {'route': '#', 'label': 'Fuhrpark', 'icon': 'images/icons/pen.svg'},
            {'route': '#', 'label': 'Materialien', 'icon': 'images/icons/pen.svg'},
            {'route': '#', 'label': 'Kataloge', 'icon': 'images/icons/book.svg'},
        ] %}


        {# 2. RENDERING: path() entfernen und direkten Wert item.route verwenden #}
        {% for item in menu_items %}
            <li>
                {# Verwendung von item.route #}
                <a href="{{ item.route }}" title="{{ item.label }}">
                    <img src="{{ asset(item.icon) }}" alt="{{ item.label }} Icon" class="nav-icon">
                    <span class="sidebar-label">{{ item.label }}</span>
                </a>
            </li>
        {% endfor %}
        

        <li>
            <a href="#" title="Logout">
                {# Icons und Label für Logout ergänzt (Beispiel) #}
                <img src="{{ asset('images/icons/logout.svg') }}" alt="Logout Icon" class="nav-icon">
                <span class="sidebar-label">Logout</span>
            </a>
        </li>

    </ul>
</div>