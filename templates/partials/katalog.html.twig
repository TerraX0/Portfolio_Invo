{# partials/katalog.html.twig #}
<div class="home-grid">
    {% set kataloge = [
        { 'url': '#', 'name': 'Länder' },
        { 'url': '#', 'name': 'Behörden' },
        { 'url': '#', 'name': 'Vordrucke' },
        { 'url': '#', 'name': 'Angebote' },
        { 'url': '#', 'name': 'Förderungen' },
        { 'url': '#', 'name': 'Regelungen' },
    
    ] %}

    {% for katalog in kataloge %}
        <div class="home-grid-item">
            <a href="{{ katalog.url }}" class="no-underline">
                <h3 class="katalog-tab">{{ katalog.name }}</h3>
            </a>
        </div>
    {% endfor %}
</div>
