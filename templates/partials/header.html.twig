<header class="content-header">
    <div class="header-content">
        <nav>
            <div class="nav-logo-links">
                <div class="logo-container">
                      {% if show_logo %}
                <img src="{{ asset('images/Logo_AK_endgültig_bearbeitet2.png') }}"
                     alt="Startseite"
                     class="logo">
            {% endif %}
                </div>
            </div>
            <div class="nav-links">

         {% set nav_items = [
        {'route': '#', 'icon': 'images/icons/person.svg', 'alt': 'Profil'},
        {'route': '#', 'icon': 'images/icons/logout.svg', 'alt': 'Logout'}
    ] %}

    {# --- RENDERING-SCHLEIFE --- #}

    {% for item in nav_items %}
     
        <a href="{{ item.route }}" title="{{ item.alt }}" class="nav-link">
            {# Generische Klasse für das CSS #}
            <img src="{{ asset(item.icon) }}" alt="{{ item.alt }}" class="header-icon">
        </a>
    {% endfor %}

              
            </div>
        </nav>
    </div>
</header>
