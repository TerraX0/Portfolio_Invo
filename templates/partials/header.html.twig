<header class="content-header">
    <div class="header-content">
        <nav>
            <div class="nav-logo-links">
                <div class="logo-container">
                    <a href="{{ path('home') }}" class="logo-link" title="Startseite">
                        <img src="{{ asset('images/Logo_AK_endgültig_bearbeitet2.png') }}" alt="Startseite" class="logo">
                    </a>
                </div>
            </div>

            <div class="nav-links">
                <!--Eingeloggt als -->
                {% if app.user %}
                    <span>{{ app.user.dilp }}</span>
                    <!--Falls Admin-Rolle, anzeigen -->
                    {% set role_display = '' %}
                    {% for role in app.user.roles %}
                        {% if role == 'ROLE_ADMIN' %}
                            {% set role_display = ' / Admin' %}
                        {% endif %}
                    {% endfor %}
                    <span>{{ role_display }}</span>
                {% endif %}

              {% set nav_items = [
    {
        'route': '#', 
        'icon': '#', 
        'label': '#', 
    },
    {
        'route': '#', 
        'icon': '#', 
        'label': '#', 
        'alt': '#'
    }
] %} 

              
            </div>
        </nav>
    </div>
</header>
