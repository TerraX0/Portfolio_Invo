<header class="content-header">
    <div class="header-content">
        <nav>
            <div class="nav-logo-links">
                <div class="logo-container">
                    <a href="{{ path('home') }}" class="logo-link" title="Startseite">
                        <img src="{{ asset('images/LKA.png') }}" alt="Startseite" class="logo">
                    </a>
                </div>
            </div>

            <div class="nav-links">
                <!--Eingeloggt als -->
                {% if app.user %}
                    <span>{{ app.user.dilp }}</span>
                    <!--Falls Admin-Rolle, anzeigen -->
                    {% set role_display = '' %}
                    {% for role in app.user.roles %}
                        {% if role == 'ROLE_ADMIN' %}
                            {% set role_display = ' / Admin' %}
                        {% endif %}
                    {% endfor %}
                    <span>{{ role_display }}</span>
                {% endif %}

              {% set nav_items = [
    {
        'route': '#', 
        'icon': 'images/icons/person.svg', 
        'label': 'Profil', 
        'alt': 'Profil'
    },
    {
        'route': '#', 
        'icon': 'images/icons/logout.svg', 
        'label': 'Logout', 
        'alt': 'Logout'
    }
] %}

                {% for item in nav_items %}
                    <a href="{{ item.route }}" title="{{ item.label }}">
                        <img src="{{ asset(item.icon) }}" alt="{{ item.alt }}" class="person-icon">
                    </a>
                {% endfor %}
            </div>
        </nav>
    </div>
</header>
