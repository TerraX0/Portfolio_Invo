{% extends 'base.html.twig' %}
{# templates/zielfahndung/search_results.html.twig #}

{% set show_header = true %}
{% set show_sidebar = true %}

{% block title %}Zielfahndung Suchergebnisse{% endblock %}

{% block content %}
    <h1 class="page-title">Zielfahndung Suchergebnisse</h1>

    {% if zielfahndungen is not empty %}
        {% set formattedResults = [] %}

        {% for entry in zielfahndungen %}
            {% set formattedResults = formattedResults|merge([{
                'id': entry.id,
                'vorgangsnummer': entry.vorgangsnummer,
                'zfkenner': entry.zfkenner is not null ? entry.zfkenner.bezeichnung : '',
                'sachbearbeiter1' : entry.sachbearbeiter1,
                'sachbearbeiter2' : entry.sachbearbeiter2,
                'erfassung': entry.erfassung ? entry.erfassung|date('d.m.Y') : '',
                'festnahme': entry.festnahme ? entry.festnahme|date('d.m.Y') : '',
                'bundesland': entry.bundesland ? entry.bundesland.bezeichnung : '',
                'inhalt': entry.inhalt,
                'massnahmen': entry.massnahmen
            }]) %}
        {% endfor %}

        {% include 'partials/table_search_results.html.twig' with {
            'results': formattedResults,
            'fields': ['vorgangsnummer', 'erfassung', 'festnahme', 'inhalt', 'zfkenner', 'bundesland', 'sachbearbeiter1', 'sachbearbeiter2'],
            'fieldLabels': {
                'vorgangsnummer': 'Vorg.Nr',
                'zfkenner': 'ZF-Kenner',
                'sachbearbeiter1': 'SB 1',
                'sachbearbeiter2' : 'SB 2',
                'erfassung': 'Erfassung',
                'festnahme': 'Festnahme',
                'bundesland': 'Bundesland',
                'inhalt': 'Inhalt',
                'massnahmen' : 'Massnahmen'
            },
            'detailRoute': 'zielfahndung_show',
            'deleteRoute': 'zielfahndung_delete'
        } %}

        {# Paginierung Links #}
        <div class="pagination">
            {% if currentPage > 1 %}
                <a href="{{ path('zielfahndung_search', app.request.query.all|merge({'page': currentPage - 1})) }}">Zurück</a>
            {% endif %}
            <span>Seite {{ currentPage }} von {{ totalPages }}</span>
            {% if currentPage < totalPages %}
                <a href="{{ path('zielfahndung_search', app.request.query.all|merge({'page': currentPage + 1})) }}">Weiter</a>
            {% endif %}
        </div>

    {% else %}
        <p class="alert alert-info">Keine Ergebnisse gefunden.</p>
    {% endif %}

    <div class="action-buttons">
        <a href="{{ path('zielfahndung_search') }}" class="btn btn-primary">Zur Suchmaske</a>
        <a href="{{ path('zielfahndung') }}" class="btn btn-primary">Zur Speichermaske</a>
        <a href="{{ path('home') }}" class="btn btn-primary">Zurück zur Startseite</a>
    </div>
{% endblock %}
